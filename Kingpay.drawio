        <mxCell id="booking-payment-target" value="0..1" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="booking-payment">
