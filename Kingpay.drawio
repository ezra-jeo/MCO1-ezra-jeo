        <mxCell id="booking-status-type" value="status type" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;edgeStyle=entityRelationEdgeStyle;rounded=0;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;" edge="1" source="booking" target="booking-status" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="identity-note" value="&lt;b&gt;Identity and ownership&lt;/b&gt;&lt;br&gt;One User owns one Account.&lt;br&gt;A User can be both a customer and a superhero.&lt;br&gt;isSuperhero identifies provider eligibility.&lt;br&gt;Only eligible superheroes can be assigned as serviceProvider.&lt;br&gt;Profile/contact details are editable; account ownership is fixed.&lt;br&gt;All IDs use Long; timestamps use Instant." style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;shape=note;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFFBEA;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rules-note" value="&lt;b&gt;Booking and payment rules&lt;/b&gt;&lt;br&gt;Booking amount and parties are fixed at creation.&lt;br&gt;Either confirmation order is allowed; repeats do nothing.&lt;br&gt;Only the customer can authorize payment.&lt;br&gt;Only ConfirmedUnpaid can become ConfirmedPaid.&lt;br&gt;Debit, credit, ledger insert, and booking update succeed together.&lt;br&gt;Failure leaves ConfirmedUnpaid and no partial money changes." style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;shape=note;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFFBEA;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="60" y="990" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="ledger-note" value="&lt;b&gt;Successful transfers only&lt;/b&gt;&lt;br&gt;Permanent ledger: no update/delete operations.&lt;br&gt;Standalone transfer: no associated booking.&lt;br&gt;Booking payment: exactly one linked transfer.&lt;br&gt;Paid: paymentTransfer is present and matches the booking parties and amount.&lt;br&gt;Unpaid: paymentTransfer is absent.&lt;br&gt;Account debit/credit are internal domain operations." style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;shape=note;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFFBEA;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1130" y="830" width="390" height="210" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Kingpay | Main entity model" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid line: association; endpoint labels: multiplicity. Dashed arrow: enum type dependency. Method signatures only; DTOs and services deferred." style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="1370" width="1460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="user-is-superhero" value="- isSuperhero: boolean = false" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="user">
          <mxGeometry x="0" y="186" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="user-active" value="- active: boolean = true" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="user">
          <mxGeometry x="0" y="211" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="user-get-superhero" value="+ isSuperhero(): boolean" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="user">
          <mxGeometry x="0" y="521" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="user-get-active" value="+ isActive(): boolean" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="user">
          <mxGeometry x="0" y="546" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="user-set-superhero" value="+ setSuperhero(superhero: boolean): void" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="user">
          <mxGeometry x="0" y="571" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="user-deactivate" value="+ deactivate(): void" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="user">
          <mxGeometry x="0" y="596" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle-note" value="&lt;b&gt;Deactivation and retained history&lt;/b&gt;&lt;br&gt;active belongs to User and governs its Account.&lt;br&gt;Deactivate only with zero balance and no unfinished or unpaid bookings, in either participant role.&lt;br&gt;Inactive users cannot create bookings or send/receive transfers, including booking payments.&lt;br&gt;Retain User, Account, Booking, and TransferRecord rows.&lt;br&gt;Protect referenced rows with ON DELETE RESTRICT; no cascading removal of financial history.&lt;br&gt;Booking cancellation is outside this base model." style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;shape=note;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFFBEA;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="540" y="1050" width="380" height="275" as="geometry" />
        </mxCell>
        <mxCell id="funding-note" value="&lt;b&gt;Account creation: demo funding&lt;/b&gt;&lt;br&gt;Creation accepts an opening balance (BigDecimal).&lt;br&gt;Reject missing or negative opening balances.&lt;br&gt;Owner is the authenticated active User.&lt;br&gt;Reject creation if that User already has an Account.&lt;br&gt;The opening balance is a demo-only shortcut; it is not a transfer record.&lt;br&gt;Balance cannot be edited through profile/account updates.&lt;br&gt;A load/top-up endpoint is outside the current scope." style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;strokeColor=#64748B;shape=note;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFFBEA;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1090" width="390" height="235" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram name="Phase 2 security" id="phase-two-security"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1320" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="auth-controller" value="&lt;b&gt;AuthController&lt;/b&gt;&lt;hr&gt;+ register(RegisterRequest)&lt;br&gt;+ login(LoginRequest)&lt;br&gt;Public POST endpoints" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="280" height="145" as="geometry" /></mxCell><mxCell id="auth-service" value="&lt;b&gt;AuthService&lt;/b&gt;&lt;hr&gt;+ register(RegisterRequest): UserResponse&lt;br&gt;+ login(LoginRequest): AuthResponse&lt;br&gt;Transactional identity boundary" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="300" height="165" as="geometry" /></mxCell><mxCell id="auth-manager" value="&lt;b&gt;AuthenticationManager&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;Spring Security&amp;gt;&amp;gt;&lt;br&gt;DaoAuthenticationProvider&lt;br&gt;+ authenticate(credentials)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="230" height="145" as="geometry" /></mxCell><mxCell id="user-details" value="&lt;b&gt;KingpayUserDetailsService&lt;/b&gt;&lt;hr&gt;+ loadUserByUsername(name)&lt;br&gt;Enabled state and current authorities" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="1050" y="100" width="300" height="145" as="geometry" /></mxCell><mxCell id="users" value="&lt;b&gt;UserRepository&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;Spring Data JPA&amp;gt;&amp;gt;&lt;br&gt;+ findByUsername(name)&lt;br&gt;+ findById(id)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="280" height="145" as="geometry" /></mxCell><mxCell id="token-service" value="&lt;b&gt;TokenService&lt;/b&gt;&lt;hr&gt;+ issue(User): AuthResponse&lt;br&gt;Claims: iss, sub=user ID, iat, exp&lt;br&gt;Uses injected UTC Clock" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="300" height="155" as="geometry" /></mxCell><mxCell id="jwt-encoder" value="&lt;b&gt;JwtEncoder&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;Spring Security&amp;gt;&amp;gt;&lt;br&gt;Nimbus signer, HS256" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="280" height="125" as="geometry" /></mxCell><mxCell id="passwords" value="&lt;b&gt;PasswordEncoder&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;Spring Security&amp;gt;&amp;gt;&lt;br&gt;BCrypt, strength 12" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="770" y="430" width="230" height="125" as="geometry" /></mxCell><mxCell id="chain" value="&lt;b&gt;SecurityFilterChain&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;configured by SecurityConfig&amp;gt;&amp;gt;&lt;br&gt;Stateless bearer authentication&lt;br&gt;401/403 JSON handlers" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#E1D5E7;" vertex="1" parent="1"><mxGeometry x="1050" y="430" width="300" height="155" as="geometry" /></mxCell><mxCell id="decoder" value="&lt;b&gt;JwtDecoder&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;Spring Security&amp;gt;&amp;gt;&lt;br&gt;Signature, issuer, required expiry&lt;br&gt;No expiration grace period" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1400" y="430" width="280" height="155" as="geometry" /></mxCell><mxCell id="settings" value="&lt;b&gt;JwtSettings&lt;/b&gt;&lt;hr&gt;External signing key (redacted)&lt;br&gt;Issuer and lifetime&lt;br&gt;Validated during startup" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="280" height="145" as="geometry" /></mxCell><mxCell id="converter" value="&lt;b&gt;DatabaseJwtAuthenticationConverter&lt;/b&gt;&lt;hr&gt;+ convert(Jwt)&lt;br&gt;Reload ID subject; require active user&lt;br&gt;Current username and roles" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="1400" y="680" width="310" height="155" as="geometry" /></mxCell><mxCell id="transfers" value="&lt;b&gt;TransferService&lt;/b&gt;&lt;hr&gt;+ transferMoney(request, principal)&lt;br&gt;+ getTransferHistory(id, principal)&lt;br&gt;Implemented in Phase 4; see its page for current dependencies." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="300" height="155" as="geometry" /></mxCell><mxCell id="booking-service" value="&lt;b&gt;BookingService&lt;/b&gt;&lt;hr&gt;Participant read / assigned actor actions&lt;br&gt;Customer payment authorization&lt;br&gt;Guards before Phase 5/6 placeholders" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="420" y="950" width="300" height="155" as="geometry" /></mxCell><mxCell id="ownership" value="&lt;b&gt;OwnershipGuard&lt;/b&gt;&lt;hr&gt;+ accountOwner(id, principal)&lt;br&gt;+ bookingParticipant(id, principal)&lt;br&gt;+ bookingCustomer(id, principal)&lt;br&gt;+ bookingProvider(id, principal)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#D5E8D4;" vertex="1" parent="1"><mxGeometry x="770" y="930" width="300" height="195" as="geometry" /></mxCell><mxCell id="accounts" value="&lt;b&gt;AccountRepository&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;Spring Data JPA&amp;gt;&amp;gt;&lt;br&gt;+ findById(id)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1150" y="950" width="250" height="125" as="geometry" /></mxCell><mxCell id="bookings" value="&lt;b&gt;BookingRepository&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;Spring Data JPA&amp;gt;&amp;gt;&lt;br&gt;+ findById(id)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1450" y="950" width="250" height="125" as="geometry" /></mxCell><mxCell id="phase-note" value="&lt;b&gt;Implemented phase boundaries&lt;/b&gt;&lt;hr&gt;Authentication and booking ownership guards are shown here. Profile/wallet behavior is on Phase 3; current transfer/history dependencies are on Phase 4.&lt;br&gt;Booking and booking-payment business operations remain future phases." style="html=1;whiteSpace=wrap;rounded=0;ali