rs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1750" y="750" /><mxPoint x="1750" y="170" /></Array></mxGeometry></mxCell><mxCell id="dep-ownership-accounts" source="ownership" target="accounts" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-ownership-bookings" source="ownership" target="bookings" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="1150" /><mxPoint x="1575" y="1150" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram name="Phase 3 profiles and wallets" id="phase-three-profiles"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1350" pageHeight="1280" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="profile-controller" value="&lt;b&gt;UserController&lt;/b&gt;&lt;hr&gt;GET /users/me&lt;br&gt;PUT /users/me&lt;br&gt;DELETE /users/me&lt;br&gt;GET /users/superheroes" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="160" as="geometry" /></mxCell><mxCell id="profile-service" value="&lt;b&gt;UserService&lt;/b&gt;&lt;hr&gt;+ getMe(Principal): UserResponse&lt;br&gt;+ updateMe(UpdateUserRequest, Principal)&lt;br&gt;+ deactivateMe(Principal): void&lt;br&gt;+ getSuperheroes(Principal): List&amp;lt;SuperheroResponse&amp;gt;&lt;br&gt;&lt;br&gt;Writes: transaction, owner lock, eligibility/deactivation checks" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="340" height="230" as="geometry" /></mxCell><mxCell id="user-repo" value="&lt;b&gt;UserRepository&lt;/b&gt;&lt;hr&gt;Identity and unique-name queries&lt;br&gt;Active superhero summaries&lt;br&gt;saveAndFlush(User)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="300" height="150" as="geometry" /></mxCell><mxCell id="booking-repo" value="&lt;b&gt;BookingRepository&lt;/b&gt;&lt;hr&gt;Outstanding booking in either role&lt;br&gt;Outstanding provider assignments&lt;br&gt;Paid state excluded" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="900" y="280" width="300" height="150" as="geometry" /></mxCell><mxCell id="wallet-controller" value="&lt;b&gt;AccountController&lt;/b&gt;&lt;hr&gt;POST /accounts&lt;br&gt;GET /accounts/me&lt;br&gt;POST /accounts/me/load" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="300" height="150" as="geometry" /></mxCell><mxCell id="wallet-service" value="&lt;b&gt;AccountService&lt;/b&gt;&lt;hr&gt;+ create(Principal): AccountResponse&lt;br&gt;+ getMe(Principal): AccountResponse&lt;br&gt;+ load(LoadAccountRequest, Principal)&lt;br&gt;&lt;br&gt;Zero creation; duplicate 409&lt;br&gt;Exact positive funding; capacity check&lt;br&gt;Writes lock owner then wallet" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="430" y="500" width="340" height="230" as="geometry" /></mxCell><mxCell id="account-repo" value="&lt;b&gt;AccountRepository&lt;/b&gt;&lt;hr&gt;Find caller wallet&lt;br&gt;Check unique ownership&lt;br&gt;Joined bookable-hero query&lt;br&gt;saveAndFlush(Account)" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="900" y="500" width="300" height="150" as="geometry" /></mxCell><mxCell id="current-user" value="&lt;b&gt;CurrentUser&lt;/b&gt;&lt;hr&gt;+ active(Principal): User&lt;br&gt;+ lockActive(Principal): User&lt;br&gt;JWT stable ID before mutable username&lt;br&gt;Inactive identities rejected" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#D5E8D4;" vertex="1" parent="1"><mxGeometry x="430" y="850" width="340" height="170" as="geometry" /></mxCell><mxCell id="persistence" value="&lt;b&gt;EntityManager&lt;/b&gt;&lt;hr&gt;refresh(entity, PESSIMISTIC_WRITE)&lt;br&gt;Refresh cached state under row lock&lt;br&gt;Writes use READ_COMMITTED" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="900" y="850" width="300" height="170" as="geometry" /></mxCell><mxCell id="phase-three-rules" value="&lt;b&gt;Phase 3 contracts&lt;/b&gt;&lt;hr&gt;Immutable request/response records. One implicit demo currency; exact DECIMAL(19,2), no rounding.&lt;br&gt;Profile fields cannot replace balance, password, active status or another owner. Unknown JSON fields are ignored.&lt;br&gt;Deactivation requires zero balance and no outstanding booking; rows and ledger references are retained.&lt;br&gt;Loads are simulated funding, create no TransferRecord and are separate credits on each successful request." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1160" height="150" as="geometry" /></mxCell><mxCell id="dep-profile-controller-profile-service" source="profile-controller" target="profile-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-wallet-controller-wallet-service" source="wallet-controller" target="wallet-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-profile-service-user-repo" source="profile-service" target="user-repo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-profile-service-booking-repo" source="profile-service" target="booking-repo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-profile-service-account-repo" source="profile-service" target="account-repo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="450" /><mxPoint x="1050" y="450" /></Array></mxGeometry></mxCell><mxCell id="dep-profile-service-current-user" source="profile-service" target="current-user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="400" /><mxPoint x="390" y="930" /></Array></mxGeometry></mxCell><mxCell id="dep-wallet-service-current-user" source="wallet-service" target="current-user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-wallet-service-account-repo" source="wallet-service" target="account-repo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-current-user-user-repo" source="current-user" target="user-repo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="1040" /><mxPoint x="1260" y="150" /></Array></mxGeometry></mxCell><mxCell id="dep-current-user-persistence" source="current-user" target="persistence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-wallet-service-persistence" source="wallet-service" target="persistence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="780" /><mxPoint x="1050" y="780" /></Array></mxGeometry></mxCell><mxCell id="dep-profile-service-persistence" source="profile-service" target="persistence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="400" /><mxPoint x="800" y="1040" /><mxPoint x="1050" y="1040" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram name="Phase 4 transfers and history" id="phase-four-transfers"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="transfer-controller" value="&lt;b&gt;TransferController&lt;/b&gt;&lt;hr&gt;POST /api/v1/transfers&lt;br&gt;GET /api/v1/transfers/history/{accountId}&lt;br&gt;Validated requests and DTO envelopes&lt;br&gt;No ledger mutation route" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="175" as="geometry" /></mxCell><mxCell id="transfer-service" value="&lt;b&gt;TransferService&lt;/b&gt;&lt;hr&gt;+ transferMoney(TransferRequest, Principal)&lt;br&gt;+ getTransferHistory(Long, Principal)&lt;br&gt;&lt;br&gt;Source-owner authorization by user ID&lt;br&gt;Exact positive amount; distinct wallets&lt;br&gt;Refresh/lock both owners and wallets&lt;br&gt;Debit + credit + one ledger insert&lt;br&gt;READ_COMMITTED transaction" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="420" height="280" as="geometry" /></mxCell><mxCell id="ledger-repository" value="&lt;b&gt;TransferRecordRepository&lt;/b&gt;&lt;hr&gt;+ saveAndFlush(TransferRecord)&lt;br&gt;Incoming/outgoing history query&lt;br&gt;Order: transferDate DESC, id DESC&lt;br&gt;Used for insert and read only" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="350" height="175" as="geometry" /></mxCell><mxCell id="current-user" value="&lt;b&gt;CurrentUser&lt;/b&gt;&lt;hr&gt;+ active(Principal): User&lt;br&gt;Stable JWT user-ID subject&lt;br&gt;Missing/inactive caller rejected" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#D5E8D4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="320" height="150" as="geometry" /></mxCell><mxCell id="entity-manager" value="&lt;b&gt;EntityManager&lt;/b&gt;&lt;hr&gt;refresh(entity, PESSIMISTIC_WRITE)&lt;br&gt;1. User rows by ascending user ID&lt;br&gt;2. Wallet rows by ascending account ID&lt;br&gt;Fresh activity and balances after waiting&lt;br&gt;Compatible with Phase 3 owner-first writes" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="420" height="195" as="geometry" /></mxCell><mxCell id="account-repository" value="&lt;b&gt;AccountRepository&lt;/b&gt;&lt;hr&gt;+ findById(Long)&lt;br&gt;+ saveAndFlush(Account)&lt;br&gt;Both balance updates in same transaction" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="350" height="150" as="geometry" /></mxCell><mxCell id="ledger-entity" value="&lt;b&gt;TransferRecord&lt;/b&gt;&lt;hr&gt;Generated ID and timestamp&lt;br&gt;Fixed source, destination and amount&lt;br&gt;Successful standalone transfer record&lt;br&gt;No edit/delete API" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="1020" y="800" width="350" height="170" as="geometry" /></mxCell><mxCell id="phase-four-rules" value="&lt;b&gt;Phase 4 guarantees and limits&lt;/b&gt;&lt;hr&gt;Self-transfer/invalid amount: 400. Missing wallet: 404. Wrong source/history owner: 403.&lt;br&gt;Insufficient funds, inactive recipient or capacity conflict: 409. Failed writes roll back all changes.&lt;br&gt;One implicit demo currency; exact DECIMAL(19,2). History returns private DTOs, newest first.&lt;br&gt;Independent successful calls are separate transfers. Booking payment association remains Phase 6." style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;strokeColor=#64748B;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="830" height="180" as="geometry" /></mxCell><mxCell id="dep-transfer-controller-transfer-service" source="transfer-controller" target="transfer-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-transfer-service-ledger-repository" source="transfer-service" target="ledger-repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-transfer-service-current-user" source="transfer-service" target="current-user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="430" /><mxPoint x="200" y="430" /></Array></mxGeometry></mxCell><mxCell id="dep-transfer-service-entity-manager" source="transfer-service" target="entity-manager" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-transfer-service-account-repository" source="transfer-service" target="account-repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="420" /><mxPoint x="1195" y="420" /></Array></mxGeometry></mxCell><mxCell id="dep-ledger-repository-ledger-entity" source="ledger-repository" target="ledger-entity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="350" /><mxPoint x="1430" y="885" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="phase-five-bookings" name="Phase 5 bookings and completion"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1100"><root><mxCell id="0" value="" /><mxCell id="1" parent="0" value="" /><mxCell id="title" value="&lt;b&gt;Phase 5 - Booking and two-party completion&lt;/b&gt;&lt;br&gt;Dashed open arrow = dependency. Main entities page retains cardinalities.&lt;br&gt;No money movement during creation or confirmations. Explicit payment is now implemented; see Final - service." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#fff2cc;strokeColor=#666666;"><mxGeometry x="40" y="20" width="1380" height="85" as="geometry" /></mxCell><mxCell id="controller" value="&lt;b&gt;BookingController&lt;/b&gt;&lt;hr&gt;POST /bookings : 201&lt;br&gt;GET /bookings[/{id}] : 200&lt;br&gt;POST /{id}/confirmations/customer : 200&lt;br&gt;POST /{id}/confirmations/service-provider : 200&lt;br&gt;POST /{id}/payment : 200&lt;br&gt;Bearer required; private DTO envelope" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="40" y="160" width="360" height="210" as="geometry" /></mxCell><mxCell id="service" value="&lt;b&gt;BookingService&lt;/b&gt;&lt;hr&gt;+ create(request, caller): BookingResponse&lt;br&gt;+ getById(id, caller): BookingResponse&lt;br&gt;+ getMine(caller): List&amp;lt;BookingResponse&amp;gt;&lt;br&gt;+ confirmCustomer(id, caller): BookingResponse&lt;br&gt;+ confirmServiceProvider(id, caller): BookingResponse&lt;br&gt;+ pay(id, caller): atomic payment (Phase 6)&lt;br&gt;&lt;br&gt;Writes: READ_COMMITTED&lt;br&gt;Lock owners ascending user ID; confirmations then&lt;br&gt;refresh/lock booking before entity transition" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#666666;"><mxGeometry x="510" y="160" width="430" height="270" as="geometry" /></mxCell><mxCell id="current" value="&lt;b&gt;CurrentUser&lt;/b&gt;&lt;hr&gt;+ active(caller): User&lt;br&gt;JWT subject = stable user ID&lt;br&gt;Reload current activity/roles&lt;br&gt;No caller ID accepted from booking body" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#e1d5e7;strokeColor=#666666;"><mxGeometry x="1060" y="160" width="360" height="160" as="geometry" /></mxCell><mxCell id="bookings" value="&lt;b&gt;BookingRepository&lt;/b&gt;&lt;hr&gt;Spring Data JPA&lt;br&gt;+ findById / saveAndFlush&lt;br&gt;+ findByCustomer_User_IdOrServiceProvider_User_Id&lt;br&gt;  OrderByCreatedAtDescIdDesc&lt;br&gt;EntityGraph: customer, serviceProvider, paymentTransfer&lt;br&gt;Private both-role list; newest first, ID tie-break" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f8cecc;strokeColor=#666666;"><mxGeometry x="40" y="500" width="430" height="200" as="geometry" /></mxCell><mxCell id="accounts" value="&lt;b&gt;AccountRepository&lt;/b&gt;&lt;hr&gt;+ findByUser_Id(customerUserId)&lt;br&gt;+ findById(providerAccountId)&lt;br&gt;One wallet per user&lt;br&gt;Balances never mutated by this phase" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f8cecc;strokeColor=#666666;"><mxGeometry x="560" y="500" width="340" height="160" as="geometry" /></mxCell><mxCell id="entities" value="&lt;b&gt;EntityManager&lt;/b&gt;&lt;hr&gt;refresh(owner, PESSIMISTIC_WRITE)&lt;br&gt;refresh(booking, PESSIMISTIC_WRITE)&lt;br&gt;Owner-first protocol coordinates with&lt;br&gt;deactivation / provider eligibility changes" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#e1d5e7;strokeColor=#666666;"><mxGeometry x="1010" y="500" width="410" height="160" as="geometry" /></mxCell><mxCell id="booking" value="&lt;b&gt;Booking&lt;/b&gt;&lt;hr&gt;Fixed customer / provider / positive price&lt;br&gt;+ confirmCustomer(): void&lt;br&gt;+ confirmServiceProvider(): void&lt;br&gt;Unconfirmed -&amp;gt; own half-confirmed&lt;br&gt;Opposite confirmation -&amp;gt; ConfirmedUnpaid&lt;br&gt;Repeat confirmation: harmless in every state&lt;br&gt;ConfirmedPaid / payment link preserved" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#666666;"><mxGeometry x="40" y="810" width="430" height="210" as="geometry" /></mxCell><mxCell id="dto" value="&lt;b&gt;CreateBookingRequest / BookingResponse&lt;/b&gt;&lt;hr&gt;Input: serviceProviderAccountId, amount&lt;br&gt;Customer supplied by authenticated identity&lt;br&gt;Output: ID, time, fixed party IDs, price, status,&lt;br&gt;optional payment transfer ID&lt;br&gt;No generic update/delete or editable payment link" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="560" y="810" width="390" height="200" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;Creation and completion rules&lt;/b&gt;&lt;hr&gt;Distinct customer/provider wallets required&lt;br&gt;Provider active and isSuperhero&lt;br&gt;Exact price: positive, at most 17 integer/2 fraction digits&lt;br&gt;Funds not required until explicit payment&lt;br&gt;Each create request is a separate booking&lt;br&gt;Each side confirms only its own role" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#fff2cc;strokeColor=#666666;"><mxGeometry x="1040" y="810" width="380" height="210" as="geometry" /></mxCell><mxCell id="dep-controller-service" source="controller" target="service" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-service-current" source="service" target="current" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-service-bookings" source="service" target="bookings" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-service-accounts" source="service" target="accounts" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-service-entities" source="service" target="entities" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-service-booking" source="service" target="booking" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-service-dto" source="service" target="dto" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep-controller-dto" source="controller" target="dto" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="final-support" name="Final - support"><mxGraphModel adaptiveColors="auto" grid="1" page="1" pageWidth="1740" pageHeight="1362"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Final source declarations - support&lt;/b&gt;&lt;br&gt;Modifiers retain source/default semantics: interface methods are implicitly public; record accessors are implicit. Cross-package dependencies are shown on phase pages. Main entity cardinalities apply." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="40" y="20" width="1630" height="80" as="geometry" /></mxCell><mxCell id="source-BusinessConflictException" value="&lt;b&gt;BusinessConflictException&lt;/b&gt; &amp;lt;&amp;lt;class&amp;gt;&amp;gt;&lt;hr&gt;extends RuntimeException&lt;br&gt;[public] BusinessConflictException(message: String)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="40" y="140" width="510" height="160" as="geometry" /></mxCell><mxCell id="source-InsufficientBalanceException" value="&lt;b&gt;InsufficientBalanceException&lt;/b&gt; &amp;lt;&amp;lt;class&amp;gt;&amp;gt;&lt;hr&gt;extends RuntimeException&lt;br&gt;[public] InsufficientBalanceException(operation: String)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="600" y="140" width="510" height="160" as="geometry" /></mxCell><mxCell id="source-InvalidRequestException" value="&lt;b&gt;InvalidRequestException&lt;/b&gt; &amp;lt;&amp;lt;class&amp;gt;&amp;gt;&lt;hr&gt;extends IllegalArgumentException&lt;br&gt;[public] InvalidRequestException(message: String)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="1160" y="140" width="510" height="160" as="geometry" /></mxCell><mxCell id="source-KingpayApplication" value="&lt;b&gt;KingpayApplication&lt;/b&gt; &amp;lt;&amp;lt;class&amp;gt;&amp;gt;&lt;hr&gt;[public, static] main(args: String[]): void" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="40" y="370" width="510" height="150" as="geometry" /></mxCell><mxCell id="source-ResourceNotFoundException" value="&lt;b&gt;ResourceNotFoundException&lt;/b&gt; &amp;lt;&amp;lt;class&amp;gt;&amp;gt;&lt;hr&gt;extends RuntimeException&lt;br&gt;[public] ResourceNotFoundException(message: String)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#666666;"><mxGeometry x="600" y="370" width="510" height="160" as="geometry" /></mxCell><mxCell id="source-SkeletonExceptionHandler" value="&lt;b&gt;SkeletonExceptionHandler&lt;/b&gt; &amp;lt;&amp;lt;class&amp;gt;&amp;gt;&lt;hr&gt;[public] handleBusinessConflict(exception: BusinessConflictException): ResponseEntity&amp;lt;ApiResponse&amp;lt;Void&amp;gt;&amp;gt;&lt;br&gt;[public] handleUnexpected(exception: Exception): ResponseEntity&amp;lt;ApiResponse&amp;lt;Void&amp;gt;&amp;gt;&lt;br&gt;[public] handleInvalidRequest(exception: MethodArgumentNotValidException): ResponseEntity&amp;lt;ApiResponse&amp;lt;Map&amp;lt;String, String&amp;gt;&amp;gt;&amp;gt;&lt;br&gt;[public] handleAuthentication(exception: AuthenticationException): ResponseEntity&amp;lt;ApiResponse&amp;lt;Void&amp;gt;&amp;gt;&lt;br&gt;[public] handleAccessDenied(exception: AccessDeniedException): ResponseEntity&amp;lt;ApiResponse&amp;lt;Void&amp;gt;&amp;gt;&lt;br&gt;[public] handleNotFound(exception: ResourceNotFoundException): ResponseEntity&amp;lt;ApiResponse&amp;lt;Void&amp;gt;&amp;gt;&lt;br&gt;[public] handleExplicitRequest(exception: InvalidRequestException): ResponseEntity&amp;lt;ApiResponse&amp;lt;Void&amp;gt;&amp;gt;&lt;br&gt;[public] handleConstraintValidation(exception: ConstraintViolationException): R