# Copy this file to .env in kingpay/ and enter your local connection details.
# Spring imports this as a Java properties file: use unquoted values.
# Keep credentials out of DB_URL; enter them in the separate fields below.
DB_URL=jdbc:mysql://localhost:3306/kingpay
DB_USERNAME=CHANGE_ME
DB_PASSWORD=

# validate checks existing tables without creating/updating them.
# Use update only for the confirmed dedicated development database.
DB_DDL_AUTO=validate

# Base64 encoding of at least 32 cryptographically random bytes; never commit the real key.
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_KEY
JWT_ISSUER=kingpay
JWT_TTL_SECONDS=3600
